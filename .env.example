# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sweety?schema=public"

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Authentication: use a random secret of at least 32 characters
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
COOKIE_NAME=sweety_token

# Date-only validation and reporting timezone
APP_TIMEZONE=Asia/Kolkata

# Demo account created by the seed script
SEED_DEMO_PASSWORD=ChangeMe123!

# Optional frontend API URL (Vite build-time variable)
VITE_API_URL=http://localhost:5000/api
